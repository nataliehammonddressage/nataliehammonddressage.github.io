---
import Page from '../../layouts/Page.astro';
import hero from '../../assets/images/2020/NatalieHammondDressage2020-6.jpg';
---

<Page
  title="Contact Natalie Hammond Dressage"
  heading="Get in touch"
  eyebrow="Contact"
  lede="Questions about lessons, training, or just want to say hello? Send Natalie a note."
  description="Contact Natalie Hammond Dressage with questions about dressage lessons and training in the St. Louis area."
  keywords="contact, dressage, dressage training, dressage boarding, st louis, saint louis, equestrian"
  hero={hero}
  heroAlt="Natalie and Rhapsody"
  heroPosition="50% 35%"
>
  <!-- Netlify picks this form up at deploy time; submissions show in the Netlify dashboard -->
  <form name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="contact" />
    <p hidden>
      <label>Don't fill this out: <input name="bot-field" /></label>
    </p>
    <div class="row">
      <label>
        <span>Name</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
    </div>
    <label>
      <span>Message</span>
      <textarea name="message" rows="7" required></textarea>
    </label>
    <button class="btn" type="submit">Send message</button>
  </form>
</Page>

<style>
  form {
    max-width: var(--prose);
    margin-inline: auto;
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-weight: 500;
    font-size: 0.95rem;
  }
  input,
  textarea {
    font: inherit;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    width: 100%;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }
  button {
    justify-self: start;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }
</style>
