---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate, getPosts } from '../../utils';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { title, description, date, updated, image, imageAlt, keywords, album: albumRef } = post.data;
const { Content } = await render(post);
const album = albumRef ? await getEntry(albumRef) : undefined;
const more = posts.filter((p) => p.id !== post.id).slice(0, 3);
const url = `${SITE.url}/blog/${post.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: 'Natalie Hammond', url: `${SITE.url}/about/` },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  ...(keywords && { keywords }),
};
---

<Base
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  jsonLd={jsonLd}
>
  <article>
    <header class="head wrap">
      <p class="eyebrow"><a href="/blog/">Journal</a></p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span> · Updated {formatDate(updated)}</span>}
      </p>
    </header>
    {
      image && (
        <div class="wrap hero">
          <Image
            src={image}
            alt={imageAlt ?? title}
            widths={[640, 1024, 1600, 2200]}
            sizes="(max-width: 1200px) 100vw, 1152px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    <div class="wrap body">
      <div class="prose">
        <Content />
      </div>
    </div>
    {
      album && (
        <section class="wrap album" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Photo gallery</h2>
          <Gallery photos={album.data.photos} label={album.data.title} />
        </section>
      )
    }
  </article>

  {
    more.length > 0 && (
      <aside class="section wrap more" aria-labelledby="more-title">
        <h2 id="more-title">More from the journal</h2>
        <div class="grid">
          {more.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </aside>
    )
  }
</Base>

<style>
  .head {
    text-align: center;
    max-width: calc(var(--prose) + 10rem);
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }
  .head .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .hero img {
    width: 100%;
    max-height: 75dvh;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .body {
    padding-top: clamp(2rem, 5vw, 3rem);
  }
  .prose {
    margin-inline: auto;
  }
  .album {
    padding-top: 2rem;
  }
  .album h2 {
    max-width: var(--prose);
    margin-inline: auto;
  }
  .more {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
  }
</style>
