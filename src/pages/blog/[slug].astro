---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate, getPosts } from '../../utils';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { title, description, date, updated, image, imageAlt, keywords, album: albumRef } = post.data;
const { Content } = await render(post);
const album = albumRef ? await getEntry(albumRef) : undefined;
const more = posts.filter((p) => p.id !== post.id).slice(0, 3);
// Posts are newest first, so the neighbours give every post at least two internal links
const index = posts.findIndex((p) => p.id === post.id);
const newer = posts[index - 1];
const older = posts[index + 1];
const url = `${SITE.url}/blog/${post.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: 'Natalie Hammond', url: `${SITE.url}/about/` },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` },
  },
  ...(keywords && { keywords }),
};
---

<Base
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  jsonLd={jsonLd}
>
  <article>
    <header class="head wrap">
      <p class="eyebrow"><a href="/blog/">Journal</a></p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span> · Updated {formatDate(updated)}</span>}
      </p>
    </header>
    {
      image && (
        <div class="wrap hero">
          <Image
            src={image}
            alt={imageAlt ?? title}
            width={1280}
            format="avif"
            widths={[640, 1024, 1600, 2200]}
            sizes="(max-width: 1200px) 100vw, 1152px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
    <div class="wrap body">
      <div class="prose">
        <Content />
      </div>
    </div>
    {
      album && (
        <section class="wrap album" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Photo gallery</h2>
          <Gallery photos={album.data.photos} label={album.data.title} />
          {!album.data.hidden && (
            <p class="album-link">
              <a href={`/photos/${album.id}/`}>View the {album.data.title} album &rarr;</a>
            </p>
          )}
        </section>
      )
    }
  </article>

  <nav class="wrap pager" aria-label="More posts">
    {
      older && (
        <a class="older" href={`/blog/${older.id}`}>
          <span>&larr; Older</span>
          {older.data.title}
        </a>
      )
    }
    {
      newer && (
        <a class="newer" href={`/blog/${newer.id}`}>
          <span>Newer &rarr;</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>

  {
    more.length > 0 && (
      <aside class="section wrap more" aria-labelledby="more-title">
        <h2 id="more-title">More from the journal</h2>
        <div class="grid">
          {more.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </aside>
    )
  }
</Base>

<style>
  .head {
    text-align: center;
    max-width: calc(var(--prose) + 10rem);
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }
  .head .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .hero img {
    width: 100%;
    max-height: 75dvh;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .body {
    padding-top: clamp(2rem, 5vw, 3rem);
  }
  .prose {
    margin-inline: auto;
  }
  .album {
    padding-top: 2rem;
  }
  .album h2 {
    max-width: var(--prose);
    margin-inline: auto;
  }
  .more {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
  }
  .album-link {
    max-width: var(--prose);
    margin: 1.5rem auto 0;
  }
  .pager {
    max-width: calc(var(--prose) + 2 * var(--gutter));
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }
  .pager a {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager span {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pager .newer {
    grid-column: 2;
    text-align: right;
  }
  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .newer {
      grid-column: auto;
    }
  }
</style>
