---
import type { ComponentProps } from 'astro/types';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';

type Props = ComponentProps<typeof Base> & {
  heading?: string;
  eyebrow?: string;
  lede?: string;
  hero?: ImageMetadata;
  heroAlt?: string;
  heroPosition?: string;
};

const { heading, eyebrow, lede, hero, heroAlt = '', heroPosition = 'center', ...base } = Astro.props;
---

<Base {...base} image={base.image ?? hero}>
  <header class="page-head wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{heading ?? base.title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </header>
  {
    hero && (
      <div class="wrap hero">
        <Image
          src={hero}
          alt={heroAlt}
          widths={[640, 1024, 1600, 2200]}
          sizes="(max-width: 1200px) 100vw, 1152px"
          loading="eager"
          fetchpriority="high"
          style={`object-position: ${heroPosition}`}
        />
      </div>
    )
  }
  <div class="wrap content">
    <slot />
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
    max-width: calc(var(--prose) + 2 * var(--gutter));
    margin-inline: auto;
    text-align: center;
  }
  .page-head .lede {
    margin: 0;
  }
  .hero img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (max-width: 700px) {
    .hero img {
      aspect-ratio: 4 / 3;
    }
  }
  .content {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }
  .content :global(.prose) {
    margin-inline: auto;
  }
</style>
