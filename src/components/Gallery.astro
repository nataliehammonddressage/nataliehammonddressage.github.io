---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { photos, label = 'Photo gallery' } = Astro.props;

// Full-size versions for the lightbox; thumbnails come from <Image> below
const items = await Promise.all(
  photos.map(async (photo) => {
    const full = await getImage({ src: photo.src, width: Math.min(photo.src.width, 2000), format: 'webp', quality: 82 });
    return { ...photo, full: full.src };
  }),
);
---

<div class="gallery" data-gallery aria-label={label} role="list">
  {
    items.map((item, i) => (
      <a href={item.full} class="tile" data-index={i} data-caption={item.alt} role="listitem">
        <Image
          src={item.src}
          alt={item.alt}
          widths={[360, 560, 800]}
          sizes="(max-width: 600px) 50vw, (max-width: 1100px) 33vw, 360px"
          loading={i < 6 ? 'eager' : 'lazy'}
        />
      </a>
    ))
  }
  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="nav prev" type="button" aria-label="Previous photo">&#8249;</button>
    <button class="nav next" type="button" aria-label="Next photo">&#8250;</button>
    <button class="close" type="button" aria-label="Close">&times;</button>
    <p class="count" aria-live="polite"></p>
  </dialog>
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const tiles = [...gallery.querySelectorAll<HTMLAnchorElement>('.tile')];
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog')!;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector('.count')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + tiles.length) % tiles.length;
      const tile = tiles[index];
      img.src = tile.href;
      img.alt = tile.dataset.caption ?? '';
      caption.textContent = tile.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${tiles.length}`;
      // Warm the cache for the next photo
      new Image().src = tiles[(index + 1) % tiles.length].href;
    };

    tiles.forEach((tile, i) =>
      tile.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('figure')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    columns: 3 16rem;
    column-gap: 0.75rem;
  }
  @media (max-width: 600px) {
    .gallery {
      columns: 2;
      column-gap: 0.5rem;
    }
  }
  .tile {
    display: block;
    margin-bottom: 0.75rem;
    break-inside: avoid;
    border-radius: 10px;
    overflow: hidden;
    background: var(--accent-soft);
  }
  @media (max-width: 600px) {
    .tile {
      margin-bottom: 0.5rem;
    }
  }
  .tile img {
    width: 100%;
    transition: transform 0.4s ease, opacity 0.2s ease;
  }
  .tile:hover img {
    transform: scale(1.03);
    opacity: 0.92;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 12 11 / 0.97);
    color: #f2eee6;
  }
  .lightbox::backdrop {
    backdrop-filter: blur(8px);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    padding: 3.5rem 1rem 1rem;
  }
  figure img {
    max-width: min(100%, 1600px);
    max-height: calc(100dvh - 8rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }
  figcaption {
    padding-top: 0.75rem;
    font-size: 0.95rem;
    text-align: center;
    opacity: 0.85;
  }
  .lightbox button {
    position: absolute;
    background: rgb(255 255 255 / 0.08);
    color: inherit;
    border: 0;
    border-radius: 999px;
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox button:hover {
    background: rgb(255 255 255 / 0.18);
  }
  .prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .close {
    top: 0.75rem;
    right: 1rem;
  }
  .count {
    position: absolute;
    top: 1.1rem;
    left: 1.25rem;
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  @media (max-width: 600px) {
    .prev,
    .next {
      top: auto;
      bottom: 0.75rem;
      translate: none;
    }
  }
</style>
